#!/usr/bin/env bash
#
# Установка нового jar на сервере. Вызывается из CI одной командой:
#   ssh <сервер> 'sudo /usr/local/sbin/crtlogs-deploy' < build/libs/crtlogs.ru-*.jar
#
# jar приходит со stdin, а не заливается заранее: на диске деплой-пользователя ничего
# не остаётся, и подменить путь символьной ссылкой на чужой файл нельзя.
#
# Смысл отдельного скрипта — сузить sudo. Деплой-пользователю разрешена ровно эта
# команда, а не «systemctl» и «install» с произвольными аргументами, иначе ключ из
# GitHub фактически равен root на сервере.
#
# Установка (однократно, от root):
#   sudo install -o root -g root -m 755 deploy/crtlogs-deploy /usr/local/sbin/crtlogs-deploy
#   echo '<deploy-user> ALL=(root) NOPASSWD: /usr/local/sbin/crtlogs-deploy' \
#     | sudo tee /etc/sudoers.d/crtlogs-deploy
#   sudo chmod 440 /etc/sudoers.d/crtlogs-deploy
#
set -euo pipefail

# Значения переопределяемы, чтобы скрипт можно было прогнать на стенде. Через sudo это
# не подставить: env_reset (умолчание sudoers) вычищает окружение вызывающего.
APP_DIR=${APP_DIR:-/opt/crtlogs}
APP_USER=${APP_USER:-crtlogs}
SERVICE=${SERVICE:-crtlogs}
HEALTH=${HEALTH:-http://127.0.0.1:8090/api/status}
ATTEMPTS=${ATTEMPTS:-30}
DELAY=${DELAY:-2}

TARGET="$APP_DIR/crtlogs.jar"
PREVIOUS="$APP_DIR/crtlogs.jar.prev"

umask 022

staged=$(mktemp "$APP_DIR/.crtlogs.jar.XXXXXX")
trap 'rm -f "$staged"' EXIT
cat > "$staged"

# приехавшее должно быть непустым zip-архивом, а не нулём байт и не текстом ошибки
if [ ! -s "$staged" ] || [ "$(head -c 2 "$staged")" != "PK" ]; then
    echo "деплой отменён: со stdin пришёл не jar" >&2
    exit 1
fi

if [ -f "$TARGET" ]; then
    cp -p "$TARGET" "$PREVIOUS" # версия, на которую откатимся, если новая не поднимется
fi

chown "$APP_USER:$APP_USER" "$staged"
chmod 644 "$staged"
mv -f "$staged" "$TARGET" # тот же раздел, значит подмена атомарная
trap - EXIT

# Ждём, пока сервис реально начнёт отвечать. Фиксированный sleep врёт в обе стороны:
# на медленном старте объявит успех рано, на быстром — заставит ждать зря.
restart_and_wait() {
    systemctl restart "$SERVICE"
    for _ in $(seq 1 "$ATTEMPTS"); do
        if curl -fsS -m 3 -o /dev/null "$HEALTH"; then
            return 0
        fi
        sleep "$DELAY"
    done
    return 1
}

if restart_and_wait; then
    echo "деплой ок: $SERVICE отвечает на $HEALTH"
    exit 0
fi

echo "$SERVICE не поднялся за $((ATTEMPTS * DELAY)) с — откат" >&2
journalctl -u "$SERVICE" -n 50 --no-pager >&2 || true

if [ ! -f "$PREVIOUS" ]; then
    echo "предыдущей версии нет, откатывать не на что" >&2
    exit 1
fi

cp -p "$PREVIOUS" "$TARGET"
if restart_and_wait; then
    echo "откат выполнен, работает предыдущая версия" >&2
else
    echo "откат не помог, сервис не отвечает" >&2
fi
exit 1
